# Copy this file to `.env` and adjust for your environment.
# In production, DEBUG must be 0 and SECRET_KEY must be a strong, unique value —
# the app refuses to start with DEBUG=0 and an unset/placeholder SECRET_KEY.

# --- Core ---
# Enable verbose errors, browsable docs, and the MCP server. NEVER set to 1 in production.
DEBUG=1

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Comma-separated. Required when DEBUG=0 (e.g. "example.com,api.example.com").
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to call the API from a browser (e.g. "https://app.example.com").
CORS_ALLOWED_ORIGINS=

# Comma-separated origins trusted for CSRF (Django admin over HTTPS behind a proxy).
CSRF_TRUSTED_ORIGINS=

# --- Database ---
# Defaults to a local SQLite file when unset. Use Postgres in production:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# --- Cache / Queue ---
REDIS_URL=redis://localhost:6379/0
USE_REDIS_CACHE=0

# --- MCP (developer tooling; only served when DEBUG=1) ---
ENABLE_MCP_SERVER=1

# --- TLS / HSTS (only applied when DEBUG=0) ---
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=3600

# --- Server bind ---
HOST=0.0.0.0
PORT=8000
